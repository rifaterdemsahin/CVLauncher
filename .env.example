# Doppler Secrets Reference
# =========================
# This file documents all environment variables used by the Auto-Reply System.
# DO NOT put real values here. Store all secrets in Doppler:
#   https://dashboard.doppler.com/projects/pexabo-email-automation
#
# Run scripts with Doppler:
#   doppler run -- node scripts/process-specific-email.js "URL" --dry-run
#
# See: 5_Symbols/n8n/Auto-Reply info@pexabo.com/doppler-config.md

# ============================================
# N8N INSTANCE
# ============================================
N8N_HOST=https://n8n.rifaterdemsahin.com
N8N_MCP_ACCESS_TOKEN=
N8N_MCP_ENDPOINT=https://n8n.rifaterdemsahin.com/mcp-server/http
N8N_API_KEY=

# ============================================
# FLY.IO
# ============================================
FLY_IO_API_TOKEN=
FLY_IO_APP_URL=https://pexabo-email-brain.fly.dev

# ============================================
# GMAIL API
# ============================================
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ============================================
# AI MODEL PROVIDERS
# ============================================
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# RECRUITER RESPONSE GENERATOR
# ============================================
RECRUITER_GENERATOR_URL=https://rifat-cvs-response-generator.fly.dev/recruiter

# ============================================
# TELEGRAM (optional notifications)
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# GOOGLE SHEETS TRACKER (optional)
# ============================================
GOOGLE_SHEETS_DOC_ID=
GOOGLE_SHEETS_CREDENTIALS=
