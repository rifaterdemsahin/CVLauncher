      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.snippet }} {{ $json.subject }}",
              "operation": "regex",
              "value2": "/(opportunity|role|contract|position|hiring|remote|hybrid|inside ir35|outside ir35)/i"
            },
            {
              "value1": "={{ $json.body }} {{ $json.snippet }}",
              "operation": "regex",
              "value2": "/(rate|salary|per day|day rate|cv|resume|referral fee)/i"
            }
          ]
        }
      },
      "name": "Check for Recruiter Keywords",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -240,
        -208
      ],
      "id": "976db379-16f1-46a6-a2c1-f4b46d7f25f6"
    },
    {
      "parameters": {
        "jsCode": "// Define your actual filenames here\nconst cvMap = {\n  azure: \"Azure_DevOps_Engineer.pdf\",\n  gcp: \"GCP_DevOps_Engineer.pdf\",\n  aws: \"AWS_DevOps_Engineer.pdf\",\n  default: \"General_DevOps_Engineer.pdf\"\n};\n\nconst text = ($json.subject + \" \" + $json.snippet).toLowerCase();\nlet selectedCV = cvMap.default;\nlet techStack = \"General\";\n\n// Logic to pick the right file\nif (text.includes(\"azure\") || text.includes(\"microsoft\")) {\n  selectedCV = cvMap.azure;\n  techStack = \"Azure\";\n} else if (text.includes(\"gcp\") || text.includes(\"google cloud\")) {\n  selectedCV = cvMap.gcp;\n  techStack = \"GCP\";\n} else if (text.includes(\"aws\") || text.includes(\"amazon\")) {\n  selectedCV = cvMap.aws;\n  techStack = \"AWS\";\n}\n\n// Construct the Raw GitHub URL\n// Note: Assuming the repo is public. If private, you need headers.\nconst baseUrl = \"https://raw.githubusercontent.com/rifaterdemsahin/CVLauncher/main/5_Symbols/cvs/\";\n\nreturn {\n  json: {\n    downloadUrl: baseUrl + selectedCV,\n    fileName: selectedCV,\n    techStack: techStack,\n    ...$json // Keep original email data\n  }\n};"
      },
      "name": "Select Best CV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
